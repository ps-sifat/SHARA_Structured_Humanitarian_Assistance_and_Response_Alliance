# Copy to .env; load it with the PowerShell command in README.md.
SHARA_SUPPORT_CONTACT=
# Optional: absolute paths on your own PC. Omit to use bundled defaults.
# SHARA_DB_PATH=C:/path/to/your/local/shara.sqlite3
# SHARA_GEOGRAPHY_FILE=C:/path/to/your/geography.json
# Optional scheduled-directory-refresh settings. The default actor is an active super-admin.
# SHARA_SYNC_ACTOR_PHONE=+8801XXXXXXXXX
# SHARA_CRAWLER_USER_AGENT=SHARA/1.0 (contact: your-email@example.com)
