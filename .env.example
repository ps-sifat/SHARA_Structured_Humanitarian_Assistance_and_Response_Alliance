# Copy values into the local shell environment before starting Django or Vite.
# Replace the secret locally; this example contains no deployable credential.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8443
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
VITE_DJANGO_PROXY_TARGET=http://127.0.0.1:8000
